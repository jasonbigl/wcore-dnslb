{
    "name": "wcore/dnslb",
    "description": "DNS-based load balancer and autoscaler (Route 53 latency routing or Cloudflare round robin) for Linode and AWS EC2",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-pdo_sqlite": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Wcore\\Dnslb\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wcore\\Dnslb\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true
    }
}
